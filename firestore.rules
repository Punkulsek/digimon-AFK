rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider == 'google.com'; }
  match /players/{uid} {
   allow read: if owner(uid);
   allow create, update: if owner(uid)
    && request.resource.data.keys().hasOnly(['schema','revision','chunks','updatedAt'])
    && request.resource.data.schema == 1
    && request.resource.data.revision is int && request.resource.data.revision > 0
    && request.resource.data.chunks is int && request.resource.data.chunks >= 1 && request.resource.data.chunks <= 200
    && request.resource.data.updatedAt == request.time;
   match /saveChunks/{chunk} {
    allow read, delete: if owner(uid);
    allow create, update: if owner(uid)
     && request.resource.data.keys().hasOnly(['text','revision'])
     && request.resource.data.text is string && request.resource.data.text.size() <= 192000
     && request.resource.data.revision is int && request.resource.data.revision > 0;
   }
  }
 }
}

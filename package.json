{
  "name": "pokemon-idle-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-standalone.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "build:web": "vite build && node scripts/check-pages.mjs && node scripts/verify-deploy.mjs",
    "test:firebase": "firebase emulators:exec --only firestore --project demo-pokemon-eternal 'node --test tests/firebase/*.test.js'"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.55.0",
    "firebase-tools": "^14.22.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "lucide": "^0.468.0"
  }
}
